FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml .
COPY libs/ libs/
COPY services/ services/
COPY ml/ ml/
RUN pip install --no-cache-dir -e . && pip install --no-cache-dir -e ./libs/clausebook_core 2>/dev/null || true
ENV PYTHONPATH=/app:/app/libs
EXPOSE 8000
CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
